third_party/*/build_x64/

# Katalogi buildu komponentu (x64 domyslny + x86) i spakowany pakiet
build_x86/
build_x64/
dist/
*.fb2k-component

# Pobrane narzedzia (instalatory foobara itp.) — nie do repo
tools/

# === foobar2000 SDK (pobierane skryptem fetch_sdk, NIE commitowane) ===
